# Local Next.js/Vercel-compatible environment.
APP_PORT=5001

# App code reads these only through src/lib/env.ts (Zod-validated at request time, not at build time).

# Neon Postgres (auto-provisioned by Vercel Marketplace Neon integration).
# Precedence: DATABASE_URL, then Vercel's POSTGRES_URL, then POSTGRES_PRISMA_URL.
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# Signs magic-link and session tokens. Required everywhere sign-in is used; there is no fallback,
# so sign-in answers 503 without it. Generate one locally: openssl rand -base64 32
# On Vercel it is set for Production and Preview (sensitive).
AUTH_SECRET=

# Optional public URL used inside generated magic links on Vercel.
# PUBLIC_APP_URL=https://your-preview-or-production-url.vercel.app

# Optional real email delivery. Without these, the app shows a dev magic link.
# RESEND_API_KEY=re_xxx
# AUTH_EMAIL_FROM="Museums EU Atlas <noreply@example.com>"

# Optional commit id reported by /api/healthz outside Vercel (Vercel sets VERCEL_GIT_COMMIT_SHA).
# GIT_COMMIT=
